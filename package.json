{
  "name": "vs_toolkit",
  "version": "1.0.3",
  "description": "Toolkit for creating to easily develop Hybrid/Web Applications for mobile devices.",
  "repository": "git@github.com:vinisketch/VSToolkit.git",
  "author": "<david@thevenin.jp>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublish": "npm run clean && npm run build",
    "tsc:core": "tsc -p src/tsconfig.core.json",
    "tsc": "npm run tsc:core && npm run tsc:ui && npm run tsc:fx",
    "btest": "tsc -p tsconfig.test.json",
    "prebuild": "npm run tsc",
    "build:core": "rollup -c ./rollup.config/core.mjs",
    "build": "npm run build:core",
    "test": "mocha",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "tsc:ui": "tsc -p src/tsconfig.ui.json",
    "build:ui": "npm run tsc:ui && rollup -c ./rollup.config/ui.mjs",
    "tsc:fx": "tsc -p src/tsconfig.fx.json",
    "build:fx": "npm run tsc:fx && rollup -c ./rollup.config/fx.mjs",
    "build:css": "node tools/build-themes.mjs",
    "gui": "esbuild tests/gui/harness.ts --bundle --format=esm --target=es2022 --sourcemap --loader:.html=text --tsconfig=tests/tsconfig.json --outdir=tests/gui/build --servedir=. --serve"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jest": "^30.5.2",
    "less": "^4.9.1",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vs_gesture": "../VS_gesture",
    "vs_ui_utils": "../VS_ui_utils",
    "vs_utils": "../VS_utils",
    "winston": "^3.19.0"
  },
  "types": "./dist/",
  "exports": {
    "./vs_core": {
      "types": "./dist/vs_core.d.ts",
      "import": "./dist/vs_core.es.js",
      "require": "./dist/vs_core.amd.js"
    },
    "./vs_ui": {
      "types": "./dist/vs_ui.d.ts",
      "import": "./dist/vs_ui.es.js",
      "require": "./dist/vs_ui.amd.js"
    },
    "./vs_fx": {
      "types": "./dist/vs_fx.d.ts",
      "import": "./dist/vs_fx.es.js",
      "require": "./dist/vs_fx.amd.js"
    }
  },
  "engines": {
    "node": ">=15.0.0"
  },
  "type": "module"
}
