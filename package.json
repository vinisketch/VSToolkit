{
  "name": "vs_toolkit",
  "version": "1.0.3",
  "description": "Toolkit for creating to easily develop Hybrid/Web Applications for mobile devices.",
  "repository": "git@github.com:vinisketch/VSToolkit.git",
  "author": "<david@thevenin.jp>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublish": "npm run clean && npm run build",
    "tsc:core": "tsc -p src/tsconfig.core.json",
    "tsc:data": "tsc -p src/tsconfig.data.json",
    "btest": "tsc -p tsconfig.test.json",
    "prebuild": "npm run tsc",
    "build:core": "rollup -c ./rollup.config/core.mjs",
    "build:data": "rollup -c ./rollup.config/data.mjs",
    "build": "npm run build:core"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript/typescript6": "^6.0.2",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vs_gesture": "../VS_gesture",
    "vs_ui_utils": "../VS_ui_utils",
    "vs_utils": "../VS_utils",
    "winston": "^3.19.0"
  },
  "types": "./dist/",
  "exports": {
    "./vs_core": {
      "import": "./dist/vs_core.es.js",
      "require": "./dist/vs_core.amd.js",
      "types": "./dist/vs_core.d.js"
    }
  },
  "engines": {
    "node": ">=15.0.0"
  }
}
