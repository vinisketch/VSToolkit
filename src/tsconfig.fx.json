{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../build",
    "target": "es2022",
    "module": "es2022",
    "emitDeclarationOnly": true,
    // the fx imports the core and ui sources (see paths): not a composite
    // project
    "composite": false,
    "incremental": false,
    "paths": {
      "vs_toolkit/vs_core": ["./core/index.ts"],
      "vs_toolkit/vs_ui": ["./ui/index.ts"]
    }
  },
  "include": [
    "./fx/**/*.ts",
    "./ui/html.d.ts",
  ],
}
